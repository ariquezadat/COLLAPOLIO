# Puerto del servidor de sockets
PORT=4000

# Orígenes permitidos, separados por coma (el frontend)
CORS_ORIGIN=http://localhost:3000

# Redis para salas activas. Sin esta variable el servidor usa memoria
# (suficiente para desarrollo, no para varias instancias).
# REDIS_URL=redis://default:password@host:6379

# Postgres para perfiles, historial y estadísticas. Todo opcional:
# sin esta variable el juego funciona igual, sólo no guarda historial.
# DATABASE_URL=postgresql://user:password@host:5432/collapolio
